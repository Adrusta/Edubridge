class Calculator {

    // Returns the sum of two integers
    int calculate(int a, int b) {
        return a + b;
    }

    // Returns the product of two double values
    double calculate(double a, double b) {
        return a * b;
    }

    // Returns the largest of three integers
    int calculate(int a, int b, int c) {
        return Math.max(a, Math.max(b, c));
    }

    // Returns the difference as a double
    double calculate(int a, double b) {
        return a - b;
    }

    public static void main(String[] args) {
        Calculator obj = new Calculator();

        System.out.println("Sum: " + obj.calculate(10, 20));
        System.out.println("Product: " + obj.calculate(5.0, 4.0));
        System.out.println("Largest: " + obj.calculate(10, 30, 20));
        System.out.println("Difference: " + obj.calculate(10, 4.5));
    }
}
